/* =========================
   ACHIEVEMENTS SECTION
   (LIGHT DENTAL THEME)
========================= */

.achievements {
    background: linear-gradient(135deg, #f8fafc, #fff7ed);
    padding: 100px 20px;
    font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    position: relative;
    overflow: hidden;
}

/* Decorative Background Glow */
.achievements::before {
    content: "";
    position: absolute;
    top: -15%;
    left: -10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle,
            rgba(249, 115, 22, 0.12) 0%,
            transparent 70%);
    pointer-events: none;
}

.achievements::after {
    content: "";
    position: absolute;
    bottom: -20%;
    right: -10%;
    width: 450px;
    height: 450px;
    background: radial-gradient(circle,
            rgba(59, 130, 246, 0.08) 0%,
            transparent 70%);
    pointer-events: none;
}

/* Container */
.achievements .container {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 2;
}

/* Title */
.achievements .title {
    font-size: 2.8rem;
    font-weight: 800;
    color: #1e293b;
    margin-bottom: 12px;
    letter-spacing: -0.02em;
}

/* Subtitle */
.achievements .subtitle {
    font-size: 1.1rem;
    color: #64748b;
    max-width: 600px;
    margin: 0 auto 60px;
    font-weight: 500;
}

/* Grid */
.achievements .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
}

/* Card */
.achievements .box {
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);

    padding: 50px 30px;
    border-radius: 30px;

    border: 1px solid rgba(249, 115, 22, 0.12);

    box-shadow:
        0 10px 35px rgba(15, 23, 42, 0.08);

    transition: all 0.4s ease;

    display: flex;
    flex-direction: column;
    align-items: center;
}

/* Hover */
.achievements .box:hover {
    transform: translateY(-12px);

    background: #ffffff;

    border-color: #f97316;

    box-shadow:
        0 20px 45px rgba(249, 115, 22, 0.18);
}

/* Numbers */
.achievements .box h3 {
    font-size: 3.5rem;
    font-weight: 800;

    margin-bottom: 10px;
    line-height: 1;

    background: linear-gradient(135deg, #fb923c, #ea580c);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

/* Labels */
.achievements .box p {
    font-size: 0.9rem;
    color: #475569;

    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.15em;
}

/* Responsive */
@media (max-width:1024px) {

    .achievements .grid {
        grid-template-columns: repeat(2, 1fr);
    }

}

@media (max-width:640px) {

    .achievements {
        padding: 70px 20px;
    }

    .achievements .title {
        font-size: 2.2rem;
    }

    .achievements .grid {
        grid-template-columns: 1fr;
        gap: 20px;
    }

    .achievements .box {
        padding: 40px 20px;
    }

    .achievements .box h3 {
        font-size: 3rem;
    }

}